<?xml version="1.0" encoding="utf-8"?>
<!--
  Public sites: system CAs only. Plain http is allowed because a self-hosted SearXNG is
  often http://host:8080 on the LAN or Tailscale.

  Home-network names (*.lan, *.home.arpa, *.internal) also trust user-installed CAs, so a
  self-hosted SearXNG behind a reverse proxy with its own CA (e.g. Caddy "tls internal")
  works once that root certificate is installed on the phone. User CAs are never trusted
  for public domains.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home.arpa</domain>
        <domain includeSubdomains="true">internal</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
